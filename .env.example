# OPENDOTA_API_KEY - Optional. Your OpenDota API key (https://www.opendota.com/api-keys).
# Raises the rate limit from 60/min (shared free tier) to 3000/min.
# OPENDOTA_API_KEY=

# OPENDOTA_LANGUAGE - Optional. Default language for hero/item/ability names.
# Accepts Steam codes (english, schinese, russian, ...) or tags (en, zh-CN, ru, ...).
# OPENDOTA_LANGUAGE=english

# OPENDOTA_BASE_URL - Optional. Override for a self-hosted OpenDota instance.
# OPENDOTA_BASE_URL=https://api.opendota.com/api

# OPENDOTA_RATE_LIMIT - Optional. Max requests/minute the client will send (default 55 without key, 1200 with key).
# OPENDOTA_RATE_LIMIT=55

# OPENDOTA_CONSTANTS_TTL_MINUTES - Optional. How long game constants (heroes/items/abilities/enums)
# stay cached before a background refresh (stale-while-revalidate: stale data is served instantly).
# Default 60 minutes.
# OPENDOTA_CONSTANTS_TTL_MINUTES=60
